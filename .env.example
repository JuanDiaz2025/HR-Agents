# ============================================================================
#  AI INTERVIEWER — configuration
#  Copy to .env and fill in. Every integration is optional: leave a section
#  blank and that part runs in a logged no-op mode instead of crashing.
#  Check what is actually live with:  GET /health/integrations
# ============================================================================

# ---------------------------------------------------------------- 1. THIS APP
ENV=dev                                   # dev | staging | prod
LOG_LEVEL=INFO

# Public HTTPS URL of this service. Recall.ai calls back into it, so it must be
# reachable from the internet. In development use a *static* ngrok domain —
# a URL that changes between restarts breaks every scheduled bot.
PUBLIC_BASE_URL=https://your-static-domain.ngrok-free.app

# Shared secret for our own /api/bookings and /api/interviews routes.
# Generate with:  openssl rand -hex 32
INTERNAL_API_KEY=change-me

# SQLite is fine for a few hundred interviews. Switch to Postgres to run more
# than one worker:  postgresql+psycopg://user:pass@host:5432/hr_agents
DATABASE_URL=sqlite+pysqlite:///./hr_agents.db

# ------------------------------------------------------------- 2. RECALL.AI
# Dashboard: https://us-west-2.recall.ai/dashboard/developers/api-keys
RECALL_API_KEY=
RECALL_REGION=us-west-2                   # us-east-1 | us-west-2 | eu-central-1 | ap-northeast-1

# Workspace verification secret ("whsec_..."), from the same API keys page.
# Without it inbound webhooks cannot be verified — required when ENV=prod.
RECALL_WEBHOOK_SECRET=

# Extra token appended to the per-bot real-time endpoint URL.
# Generate with:  openssl rand -hex 32
RECALL_REALTIME_TOKEN=change-me

BOT_NAME=AI Interviewer
RECALL_REALTIME_TRANSPORT=webhook         # webhook (simplest) | websocket (lower latency)
VOICE_OUTPUT_MODE=output_audio            # output_audio (server TTS) | output_media (browser page)
BOT_SILENCE_TIMEOUT_S=300

# ---------------------------------------------------------------- 3. CLAUDE
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
INTERVIEW_MODEL=claude-opus-5
SCORING_MODEL=claude-opus-5
INTERVIEW_EFFORT=low                      # per-turn decisions are latency-sensitive
SCORING_EFFORT=high                       # the scorecard is worth thinking about

# ------------------------------------------------------------------- 4. VOICE
TTS_PROVIDER=silent                       # elevenlabs | openai | google | silent
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
GOOGLE_TTS_VOICE=en-US-Neural2-F

# -------------------------------------------------------- 5. GOOGLE WORKSPACE
# Service-account JSON key with domain-wide delegation. The account impersonates
# a real Workspace mailbox, because a bare service account cannot create Google
# Meet conferences or send invitations.
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
GOOGLE_IMPERSONATED_USER=interviewer@equitytrackph.com
INTERVIEWER_EMAIL=interviewer@equitytrackph.com
CALENDAR_ID=primary
INTERVIEW_TIMEZONE=Asia/Manila
INTERVIEW_DURATION_MINUTES=30

# ---------------------------------------------------------- 6. GOOGLE SHEETS
# The id from the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
# Share the sheet with the service-account email as an Editor.
SHEETS_SPREADSHEET_ID=
SHEETS_TAB_NAME=Interviews

# ------------------------------------------------------------- 7. MONDAY.COM
# monday.com -> avatar -> Developers -> My Access Tokens
MONDAY_API_KEY=
# Board 4277249290 = "Hiring / Talent Acquisition" (Twin Home Buyer workspace).
MONDAY_BOARD_ID=4277249290
MONDAY_GROUP_PROCEED=new_group59160      # Initial Interview
MONDAY_GROUP_REVIEW=new_group49772       # Applicant Screening
MONDAY_GROUP_REJECTED=new_group56420     # Applicants that will not continue
# Column ids differ per board — see SETUP.md step 7. Only mapped fields are
# written; unmapped ones, missing ids and unwritable column types are skipped.
MONDAY_COLUMN_MAP={"status":"dup__of_progress","score":"text8","interview_date":"date"}

# ---------------------------------------------------------- 8. NOTIFICATIONS
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
HR_NOTIFY_EMAILS=hr@equitytrackph.com,juan@equitytrackph.com

# ------------------------------------------------- 9. INTERVIEW BEHAVIOUR
ANSWER_DEBOUNCE_S=2.5                     # silence before we treat an answer as finished
MAX_FOLLOWUPS_PER_QUESTION=2
MAX_QUESTIONS=20
MAX_INTERVIEW_SECONDS=1800
SPEECH_WORDS_PER_SECOND=2.6
# Pull facts mid-interview after questions in these categories, so a hard
# blocker ends the call early. Empty disables the extra LLM calls.
EARLY_EXIT_CHECK_CATEGORIES=availability
