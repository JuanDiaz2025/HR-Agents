# ---------------------------------------------------------------------------
# AI Sales Practice & Testing System
# Copy to .env and fill in what you have. Everything is optional - the system
# degrades honestly and `npm run doctor` tells you which phases are live.
# ---------------------------------------------------------------------------

# --- Phase 3 + 4: the AI seller's voice, and Phase 5 transcription -----------
# Needed for: live calls, transcription, and (optionally) scoring.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_SCORING_MODEL=gpt-4o

# --- Phase 5: scoring and coaching -------------------------------------------
# Either provider can grade. SCORING_PROVIDER: auto | anthropic | openai | offline
ANTHROPIC_API_KEY=
ANTHROPIC_SCORING_MODEL=claude-sonnet-5
SCORING_PROVIDER=auto

# --- Phase 4: telephony -------------------------------------------------------
# The AI seller calls FROM your Twilio number TO your sales line.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+14155550100
SALES_LINE_NUMBER=+14155550134

# Public https URL that Twilio can reach for webhooks and the media stream.
# For a same-day test: `ngrok http 3000` and paste the https URL here.
PUBLIC_URL=

# --- Dashboard ----------------------------------------------------------------
# A shared password for the web dashboard. Optional when you are only on
# localhost. REQUIRED once PUBLIC_URL is set: without it the dashboard is
# readable by anyone with the ngrok link, and starting calls from it is
# disabled so a stranger cannot spend your call budget.
# Open the dashboard once with ?token=... and it is remembered in a cookie.
DASHBOARD_TOKEN=

# --- Local -------------------------------------------------------------------
PORT=3000
DATA_DIR=
