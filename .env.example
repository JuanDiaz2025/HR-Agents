# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
HR_AGENTS_MODEL=claude-opus-5
HR_AGENTS_EFFORT=high              # low | medium | high | xhigh | max

# Evaluation inputs
HR_AGENTS_FRAME_COUNT=6            # frames sampled evenly across the video
HR_AGENTS_MAX_VIDEO_SECONDS=900    # refuse anything longer, to bound cost

# Rubric
HR_AGENTS_RUBRIC=config/rubric.yaml

# Google Sheets (store=sheets)
HR_AGENTS_STORE=sheets             # sheets | csv
HR_AGENTS_SPREADSHEET_ID=
HR_AGENTS_WORKSHEET=Form Responses 1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# CSV store (store=csv) — local development
HR_AGENTS_CSV_PATH=submissions.csv

# Transcription
HR_AGENTS_WHISPER_MODEL=base.en
